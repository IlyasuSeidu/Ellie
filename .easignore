# Keep this aligned with .gitignore because EAS uses this file instead of
# .gitignore once it exists.

# dependencies
node_modules/

# Expo
.expo/
.firebase/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# git metadata is not needed in the remote EAS build archive
.git/

# local env files and console secrets
.env
.env*.local
backend/functions/.secret.local
GoogleService-Info.plist
google-services.json
google-play-key.json
web-admin/analytics-intelligence/firebase-config.local.js

# typescript
*.tsbuildinfo

# test coverage and reports
coverage/
artifacts/
reports/
tests/
e2e/
docs/
*.md

# generated native folders
/ios
/android

# backend and web-only outputs not needed for mobile EAS builds
backend/
web-admin/
build-in-public/
design/

# source images are retained in git but not needed at runtime
assets/onboarding/icons/source/

# local training/build scratch
.tmp-*/
.venv-oww/
modules/ryvro-openwakeword/android/.gradle/
modules/ryvro-openwakeword/android/build/
