# Ryvro production environment template
# Copy to .env after the owner has created the production app/services.
# Keep this file committed with placeholders only. Never commit filled secrets.

APP_ENV=production

# EAS project created with `eas init`
EAS_PROJECT_ID=b306643e-1688-448e-8acd-f72bf74312c3

# Firebase production project for com.ryvro.shiftplanner
FIREBASE_API_KEY=AIza_REPLACE_WITH_RYVRO_PROD_KEY
FIREBASE_AUTH_DOMAIN=ryvro-shift-planner.firebaseapp.com
FIREBASE_PROJECT_ID=ryvro-shift-planner
FIREBASE_STORAGE_BUCKET=ryvro-shift-planner.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=1002666052675
FIREBASE_APP_ID=1:1002666052675:web:c5f220238c9282686b98f6
FIREBASE_MEASUREMENT_ID=
# Download fresh native Firebase service files after creating the Ryvro iOS/Android apps.
# Keep them at the repo root; the filenames are gitignored and survive `expo prebuild --clean`.
EXPO_IOS_GOOGLE_SERVICES_FILE=./GoogleService-Info.plist
EXPO_ANDROID_GOOGLE_SERVICES_FILE=./google-services.json
# For EAS cloud builds, upload these same files separately as file variables:
# GOOGLE_SERVICES_PLIST and GOOGLE_SERVICES_JSON

# Google OAuth clients from the same Firebase / Google Cloud project
GOOGLE_WEB_CLIENT_ID=1002666052675-qnj0l50lectmqq4g44alrvb0iuvaoh75.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1002666052675-qnj0l50lectmqq4g44alrvb0iuvaoh75.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=1002666052675-le1ivq51bi0dv77pt24kvtir90qli2io.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1002666052675-le1ivq51bi0dv77pt24kvtir90qli2io.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=1002666052675-94b6mo0a78vr4kjb8ql8rorpe9rrovch.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=1002666052675-94b6mo0a78vr4kjb8ql8rorpe9rrovch.apps.googleusercontent.com

# Live Ryvro API and Cloud Functions
API_BASE_URL=https://api.getryvro.com
API_TIMEOUT=30000
RYVRO_BRAIN_URL=https://us-central1-ryvro-shift-planner.cloudfunctions.net/ryvroBrain
RYVRO_BRAIN_TIMEOUT=30000
SHIFT_SCHEDULE_PARSER_URL=https://us-central1-ryvro-shift-planner.cloudfunctions.net/parseShiftScheduleDescription
SHIFT_SCHEDULE_PARSER_TIMEOUT_MS=45000
SHIFT_SCHEDULE_PARSER_MAX_PROMPT_LENGTH=2000

# RevenueCat production apps and entitlement
REVENUECAT_IOS_KEY=appl_REPLACE_WITH_RYVRO_IOS_KEY
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_REPLACE_WITH_RYVRO_IOS_KEY
REVENUECAT_ANDROID_KEY=goog_REPLACE_WITH_RYVRO_ANDROID_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_REPLACE_WITH_RYVRO_ANDROID_KEY
REVENUECAT_ENTITLEMENT_ID=pro
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# Published legal and support URLs
LEGAL_PRIVACY_POLICY_URL=https://getryvro.com/privacy
LEGAL_TERMS_OF_SERVICE_URL=https://getryvro.com/terms
SUPPORT_URL=https://getryvro.com/support
ACCOUNT_DELETION_URL=https://getryvro.com/delete-account

# Wake word and builder feature flags
WAKE_WORD_PROVIDER=openwakeword
PICOVOICE_ACCESS_KEY=
WAKE_WORD_ENABLED=false
WAKE_WORD_AUTO_START=true
WAKE_WORD_SENSITIVITY=0.65
WAKE_WORD_PHRASE=Ryvro
WAKE_WORD_KEYWORD_PATHS=
WAKE_WORD_KEYWORD_PATHS_ANDROID=ryvro_android.ppn
WAKE_WORD_KEYWORD_PATHS_IOS=ryvro_ios.ppn
WAKE_WORD_BUILT_IN_KEYWORDS=
OPENWAKEWORD_MODEL_PATH=
OPENWAKEWORD_MODEL_PATH_ANDROID=
OPENWAKEWORD_MODEL_PATH_IOS=
OPENWAKEWORD_MELSPECTROGRAM_MODEL_PATH=
OPENWAKEWORD_MELSPECTROGRAM_MODEL_PATH_ANDROID=
OPENWAKEWORD_MELSPECTROGRAM_MODEL_PATH_IOS=
OPENWAKEWORD_EMBEDDING_MODEL_PATH=
OPENWAKEWORD_EMBEDDING_MODEL_PATH_ANDROID=
OPENWAKEWORD_EMBEDDING_MODEL_PATH_IOS=
OPENWAKEWORD_THRESHOLD=0.45
OPENWAKEWORD_TRIGGER_COOLDOWN_MS=1200
OPENWAKEWORD_MIN_RMS=0.0025
OPENWAKEWORD_ACTIVATION_FRAMES=3
OPENWAKEWORD_SCORE_SMOOTHING_ALPHA=0.35

DEBUG=false
LOG_LEVEL=info
UNIVERSAL_SHIFT_BUILDER_ENABLED=true
AI_SHIFT_BUILDER_ENABLED=true
